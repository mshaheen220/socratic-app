#!/bin/bash

TARGET_PORT=5174
LOG_FILE="$HOME/mindframe.log"
DIST_PATH="/Users/michael/Documents/dev/socratic-app/dist"

echo "⚙️ [THEFORGE] Reviewing application background processes..."

# Check if something is already hosting on our designated port
PID=$(lsof -t -i:$TARGET_PORT || true)

if [ -n "$PID" ]; then
    echo "♻️ [THEFORGE] Active server detected on port $TARGET_PORT (PID: $PID). Refreshing static assets..."
    # With static hosting, overwriting the dist folder updates the app instantly!
    # We force a path cache rehash just to guarantee clean environment memory.
    rehash
else
    echo "⚠️ [THEFORGE] No active listener found on port $TARGET_PORT. Initializing background server..."
    # Launch serve on our port using nohup so it survives terminal disconnections
    nohup npx serve -s "$DIST_PATH" -l $TARGET_PORT > "$LOG_FILE" 2>&1 &
    rehash
fi

echo "✅ [THEFORGE] Static site server successfully initialized on port $TARGET_PORT!"
echo "🌐 [THEFORGE] Mindframe is securely live at socratic.theshaheens.info"