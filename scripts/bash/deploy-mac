#!/bin/bash

# Exit immediately if any command encounters an error
set -e

echo "📦 [DEV MAC] Ensuring local node_modules dependencies are up to date..."
npm install

echo "🏗️ [DEV MAC] Compiling production-optimized static assets via Vite..."
npm run build

echo "🚀 [DEV MAC] Shipping pre-compiled 'dist' folder assets to TheForge..."
# Syncs your freshly built dist folder directly to the server project directory
scp -r ./dist michael@TheForge:/Users/michael/Documents/dev/socratic-app/

echo "🔗 [DEV MAC] Remotely triggering the deployment process handler on TheForge..."
# Executes the server-side bash script to verify or spin up the background process
ssh michael@TheForge "bash /Users/michael/Documents/dev/socratic-app/scripts/bash/deploy-forge"

echo "🎉 [DEV MAC] Deployment sequence completely finished!"
echo "🌐 [DEV MAC] Mindframe is securely live at mindframe.theshaheens.info"